# Base URL of the Spring Boot backend API. The browser calls it directly
# (no Next.js proxy), so it must be reachable from the visitor's browser.
# Also used as the fallback base URL for server-side fetches (Server
# Components, Route Handlers, generateMetadata) when API_BASE_URL_INTERNAL
# is unset — which is always the case here, so plain `npm run dev` needs
# no other variable.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Server-only base URL for server-side fetches (never exposed to the
# browser — no NEXT_PUBLIC_ prefix). Only needed in deployments where the
# server process reaches the backend at a different address than the
# browser does, e.g. Docker Compose (`http://backend:8080`). Leave unset
# for local `npm run dev`; it then falls back to NEXT_PUBLIC_API_BASE_URL
# above.
# API_BASE_URL_INTERNAL=http://backend:8080

# Public site URL, used for metadataBase, Open Graph tags, robots.txt and
# sitemap.xml generation. Optional — falls back to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
