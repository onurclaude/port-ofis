# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# --- PostgreSQL ---
POSTGRES_DB=portofis
POSTGRES_USER=portofis
POSTGRES_PASSWORD=change-me

# --- Backend (Spring Boot) ---
# Long random string used to sign admin JWTs. Required, no default.
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Bootstrap admin account, created once on first startup if admin_users is empty.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me

# Origin the backend accepts CORS requests from (the frontend's public URL).
CORS_ALLOWED_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) ---
# Public base URL the *browser* uses to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Public site URL, used for metadata/robots/sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NOTE: server-side rendering inside the frontend container reaches the backend
# via API_BASE_URL_INTERNAL=http://backend:8080, set directly in docker-compose.yml
# (fixed by the Compose network topology, not meant to be overridden here).
